# FCM client config. Copy file nay sang client/.env.fcm (KHONG commit) va dien gia tri.
# Nguon: download google-services.json (Android) va GoogleService-Info.plist (iOS) tu Firebase Console.
# Xem docs/fcm-setup.md de biet cach map gia tri.

FCM_API_KEY=
FCM_PROJECT_ID=
FCM_MESSAGING_SENDER_ID=
FCM_ANDROID_APP_ID=
FCM_IOS_APP_ID=
FCM_IOS_BUNDLE_ID=
FCM_STORAGE_BUCKET=
